# Copy to .env and fill in. .env is gitignored.

# --- DB ---
DATABASE_URL=postgresql+psycopg://paperdigest:paperdigest@localhost:5432/paperdigest

# --- LLM ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Crypto (Phase 2: encrypts user-supplied DeepSeek keys) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- App ---
APP_ENV=dev
PROMPT_VERSION=v1
LOOKBACK_DAYS=3
MAX_FETCH_PER_CATEGORY=120

# --- Auth (Phase 2) ---
SECRET_KEY=change-me-to-a-random-string
# Comma-separated invite codes. Leave empty for open registration.
INVITE_CODES=

# --- Email (Phase 4) ---
# Sign up at https://resend.com (free 3000/mo, 100/day) and paste the API key.
# Leave empty for dev: emails will be logged to stdout instead of sent.
RESEND_API_KEY=
# For Resend free tier, must be onboarding@resend.dev OR your verified domain.
MAIL_FROM=onboarding@resend.dev
# Used to build absolute unsubscribe URLs in emails. Update when deploying.
BASE_URL=http://127.0.0.1:8000
